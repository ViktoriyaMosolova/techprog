<Window x:Class="PingPong.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PingPong"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" KeyDown="UserKeyDown">
    <Grid x:Name="ActiveZone" Background="Black">
        <Rectangle Name="LeftRacket" HorizontalAlignment="Left" Height="100" Margin="0,0,0,0" Width="15" Fill="White"/>
        <Rectangle Name="RightRacket" HorizontalAlignment="Right" Height="100" Margin="0,0,0,0" Width="15" Fill="White"/>
        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Name="Ball" Height="15" Width="15" Fill="White" RadiusX="15" RadiusY="15" StrokeThickness="0"/>
        </Canvas>
        <Border BorderBrush="Black" />
        <Label Name="left" Foreground="White" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Width="200">Левый игрок:</Label>
        <Label Name="right" Foreground="White" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Width="200">Правый Игрок:</Label>
        <Label Name="label1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Visibility="Hidden">Game Over</Label>
    </Grid>
</Window>
